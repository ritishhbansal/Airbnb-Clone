
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= pageTitle %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
   <link rel="stylesheet" href="/signup.css">
  </head>
  <body>
    <%- include('../partials/nav') %>

    <main class="card" role="main" aria-labelledby="signup-title">
      <section class="hero" aria-hidden="false">
        <div class="brand">
          <div class="logo">RB</div>
          <div>
            <h1>Airbnb</h1>
            <p class="small">Find stays, host experiences — join our community</p>
          </div>
        </div>


        <div class="small">Already have an account? <a href="/login" style="color:var(--burnt-orange);text-decoration:none;font-weight:600">Log in</a></div>
      </section>

      <aside class="form-wrap">
        <form action="/signup" method="POST" novalidate>

          <% if (errors && errors.length > 0) { %>
            <div class="err" role="alert">
              <strong>Error!</strong>
              <ul>
                <% errors.forEach(error => { %>
                  <li><%= error %></li>
                <% }) %>
              </ul>
            </div>
          <% } %>

          <div class="row">
            <div>
              <label for="fname">First name</label>
              <input class="input" id="fname" type="text" name="fname" placeholder="First name" value="<%= oldInput && oldInput.fname ? oldInput.fname : '' %>" required aria-required="true" />
            </div>

            <div>
              <label for="lname">Last name</label>
              <input class="input" id="lname" type="text" name="lname" placeholder="Last name" value="<%= oldInput && oldInput.lname ? oldInput.lname : '' %>" />
            </div>
          </div>

          <div>
            <label for="email">Email</label>
            <input class="input" id="email" type="email" name="email" placeholder="you@example.com" value="<%= oldInput && oldInput.email ? oldInput.email : '' %>" required />
          </div>

          <div class="row">
            <div>
              <label for="pas">Password</label>
              <input class="input" id="pas" type="password" name="password" placeholder="Minimum 8 characters" minlength="6" required aria-required="true" />
            </div>

            <div>
              <label for="cpas">Confirm password</label>
              <input class="input" id="cpas" type="password" name="confirmpassword" placeholder="Confirm password" required />
            </div>
          </div>

          <div>
            <p style="margin:0 0 8px 0;font-weight:600;color:var(--muted-brown)">User type</p>
            <div class="usertype" role="radiogroup" aria-label="User type">
              <label><input type="radio" name="userType" value="guest" checked/> <span>Guest</span></label>
              <label><input type="radio" name="userType" value="host"/> <span>Host</span></label>
            </div>
          </div>

          <div class="termsaccepted">
            <label><input type="checkbox" name="termsAccepted" required/> I accept the <a href="/terms" style="color:var(--burnt-orange);text-decoration:none">terms & conditions</a></label>
          </div>

          <div class="cta">
            <input class="btn btn-primary" id="signup" type="submit" value="Create account" />
            <a class="btn btn-outline" href="/" role="button">Cancel</a>
          </div>

          <div style="margin-top:8px" class="small">By creating an account you agree to our <a href="/privacy" style="color:var(--burnt-orange);text-decoration:none">privacy policy</a>.</div>

        </form>
      </aside>
    </main>

  </body>
</html>







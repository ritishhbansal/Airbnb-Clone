<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <!--
      This file contains both the EJS template and embedded CSS for quick preview.
      If you prefer a separate stylesheet, move the <style> block into /public/detail.css
      and keep the <link rel="stylesheet" href="/detail.css"> line instead.
    -->
    <style>
      :root{
        --dark:#4A4A4A;
        --muted:#6D8196;
        --light:#CBCBCB;
        --pale:#FFFFE3;
        --bg: #fff;
        --radius: 14px;
        --gap: 1.25rem;
      }

      *{box-sizing:border-box}
      body{
        margin:0;
        font-family: Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;
        background: linear-gradient(180deg,var(--pale) 0%, #fff 40%);
        color:var(--dark);
        -webkit-font-smoothing:antialiased;
      }

      main{
        max-width:1100px;
        margin:40px auto;
        padding:24px;
      }

      .card{
        display:flex;
        gap:var(--gap);
        background: linear-gradient(180deg, rgba(255,255,227,0.9), rgba(255,255,227,0.6));
        border-radius:var(--radius);
        box-shadow: 0 8px 30px rgba(77,77,77,0.12);
        overflow:hidden;
        border:1px solid rgba(74,74,74,0.06);
      }

      .media{
        flex:1.15 1 520px;
        min-height:380px;
        position:relative;
        background:var(--light);
      }

      .media img{
        width:100%;
        height:100%;
        object-fit:cover;
        display:block;
      }

      .details{
        flex:1 1 420px;
        padding:28px;
        display:flex;
        flex-direction:column;
        gap:16px;
      }

      h2.page-title{
        margin:0 0 12px 0;
        color:var(--dark);
        font-size:1.6rem;
        letter-spacing:0.2px;
      }

      h3{
        margin:0 0 6px 0;
        color:var(--muted);
        font-size:1rem;
      }

      p{
        margin:0;
        color:var(--dark);
        line-height:1.5;
      }

      .meta-row{
        display:flex;
        gap:12px;
        align-items:center;
        flex-wrap:wrap;
      }

      .price{
        background:rgba(74,74,74,0.06);
        padding:10px 14px;
        border-radius:10px;
        font-weight:600;
      }

      .rating{
        display:inline-flex;
        align-items:center;
        gap:8px;
        padding:8px 12px;
        border-radius:10px;
        background:rgba(109,129,150,0.08);
        color:var(--dark);
        font-weight:600;
      }

      .rating .star{
        font-size:1.05rem;
        color:#ffb74d; /* warm star */
      }

      .desc{
        background:rgba(255,255,227,0.7);
        padding:14px;
        border-radius:10px;
        border:1px solid rgba(109,129,150,0.06);
      }

      .actions{
        margin-top:auto;
        display:flex;
        gap:12px;
        align-items:center;
      }

      .book-btn{
        background:var(--dark);
        color:var(--pale);
        padding:12px 18px;
        border-radius:10px;
        border:none;
        cursor:pointer;
        font-weight:700;
        box-shadow: 0 6px 18px rgba(74,74,74,0.12);
      }

      .book-btn:hover{ transform:translateY(-2px) }

      /* favourite as a circular button */
      .favourite{
        --size:48px;
        width:var(--size);
        height:var(--size);
        border-radius:50%;
        border:none;
        display:inline-grid;
        place-items:center;
        background:linear-gradient(180deg, rgba(109,129,150,0.12), rgba(255,255,227,0.12));
        cursor:pointer;
        font-size:1.15rem;
        transition:transform .18s ease, box-shadow .18s ease;
      }

      .favourite:active{ transform:scale(.96) }

      .favourite.hearted{
        background:linear-gradient(180deg,#ff6b6b,#ff9a9a);
        color:white;
        box-shadow: 0 8px 18px rgba(255,107,107,0.18);
      }

      /* small info grid */
      .info-grid{
        display:grid;
        grid-template-columns:repeat(2, minmax(0,1fr));
        gap:12px;
      }

      .chip{
        padding:10px 12px;
        border-radius:10px;
        background:rgba(255,255,227,0.5);
        font-size:0.95rem;
        border:1px solid rgba(74,74,74,0.04);
      }

      /* Responsive */
      @media (max-width:880px){
        .card{flex-direction:column}
        .media{min-height:240px}
        main{margin:20px}
      }

      @media (max-width:420px){
        .info-grid{grid-template-columns:1fr}
        .favourite{--size:44px}
      }
    </style>
  </head>
  <body>
    <%- include('../partials/nav') %>

    <main>
      <h2 class="page-title">Details of <%= home.houseName %></h2>

      <section class="card" aria-labelledby="home-title">
        <div class="media" aria-hidden="false">
          <img src="<%= home.photo %>" alt="Photo of <%= home.houseName %>" />
        </div>

        <div class="details">
          <div>
            <h3 id="home-title">About this place</h3>
            <div class="desc">
              <p><%= home.description %></p>
            </div>
          </div>

          <div class="info-grid">
            <div>
              <h3>Location</h3>
              <div class="chip"><%= home.location %></div>
            </div>

            <div>
              <h3>Price</h3>
              <div class="price">$<%= Number(home.price).toFixed(2) %> / night</div>
            </div>

            <div>
              <h3>Rating</h3>
              <div class="rating"><span class="star">★</span><span><%= home.rating %></span></div>
            </div>

            <div>
              <h3>Host</h3>
              <div class="chip">Hosted by <%= home.hostName || 'Host' %></div>
            </div>
          </div>

          <div class="actions">
            <form action="/book/<%= home._id %>" method="POST" style="display:inline-block;">
              <button type="submit" class="book-btn">Book Now</button>
            </form>

            <form action="/fav/<%= home._id %>" method="POST">
              <!-- You can toggle class "hearted" from server-side when item is already favourited -->
              <button class="favourite" aria-label="Add to favourites" value="submit">😍</button>
            </form>

          </div>
        </div>
      </section>
    </main>

  </body>
</html>





<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= editing ? "Edit Home" : "Add Home" %></title>
    <link rel=stylesheet href="/addhome.css">
  </head>
  <body>

    <%- include('../partials/nav') %>
    <div class="page">
      <header class="app-bar">
        <div>
          <h1><%= editing ? 'Edit Home' : 'Add Home' %></h1>
        </div>
      </header>

      <main>
        <form action="/host/<%= editing ? 'edit-home' : 'add-home' %>" method="POST" enctype="multipart/form-data" class="add">

          <div class="fields">
            <input class="input" type="hidden" name="id" value="<%= editing ? home._id : ''%>" />

            <label class="field-label">House Name</label>
            <input class="input" type="text" name="houseName" value="<%= editing ? home.houseName : ''%>" placeholder="Enter your house name" required />

            <div class="row">
              <div style="flex:1">
                <label class="field-label">Price (per night)</label>
                <input class="input" type="number" name="price" value="<%= editing ? home.price : ''%>" placeholder="e.g. 2500" min="0" step="0.01" />
              </div>
              <div style="width:160px">
                <label class="field-label">Rating</label>
                <input class="input" type="number" name="rating" value="<%= editing ? home.rating : ''%>" placeholder="0 - 5" min="0" max="5" step="0.1" />
              </div>
            </div>

            <label class="field-label">Location</label>
            <input class="input" type="text" name="location" value="<%= editing ? home.location : ''%>" placeholder="City, Area or Address" />

            <label class="field-label">Description</label>
            <textarea class="input" name="description" placeholder="Describe your home..." maxlength="1200"><%= editing ? home.description : ''%></textarea>

            <div class="meta">Tip: keep titles short and description focused on what makes your space special.</div>

            <div class="actions">
              <button type="submit" class="btn btn-primary"><%= editing ? 'Update Home' : 'Add Home' %></button>
              <a href="/host/host-home-list" class="btn btn-secondary">Cancel</a>
            </div>
          </div>

          <aside class="aside">
            <div class="meta">Photo</div>
            <div class="photo-preview" id="previewBox">
              <% if (editing && home && home.photo) { %>
                <img id="previewImg" src="/<%= home.photo %>" alt="Current Home Photo" />
              <% } else { %>
                <div id="placeholder" class="small">No image yet. Upload JPEG/JPG/PNG (recommended 1200×800).</div>
              <% } %>
            </div>

            <label class="field-label" style="margin-top:12px">Upload / Replace Photo</label>
            <div class="file-wrap">
              <input id="photoInput" class="input" type="file" name="photo" accept="image/png, image/jpeg, image/jpg" />
            </div>
            <div class="hint">Upload only if you want to change the current image. Max 5MB recommended.</div>

            <% if (editing && home && home.photo) { %>
              <div style="margin-top:12px;text-align:center">
                <button type="button" id="removePhoto" class="btn btn-secondary">Remove photo</button>
              </div>
            <% } %>
          </aside>

        </form>
      </main>
    </div>

    <script>
      // Client-side preview for file input (works in modern browsers)
      const input = document.getElementById('photoInput');
      const previewBox = document.getElementById('previewBox');
      const previewImg = document.getElementById('previewImg');
      const placeholder = document.getElementById('placeholder');

      if (input) {
        input.addEventListener('change', e => {
          const file = e.target.files && e.target.files[0];
          if (!file) return;
          if (!file.type.startsWith('image/')) return;

          const reader = new FileReader();
          reader.onload = ev => {
            if (previewImg) {
              previewImg.src = ev.target.result;
            } else {
              const img = document.createElement('img');
              img.id = 'previewImg'; img.src = ev.target.result; img.alt='Selected photo'; img.style.objectFit='cover'; img.style.width='100%'; img.style.height='100%';
              // clear placeholder then append
              if (placeholder) placeholder.style.display='none';
              previewBox.innerHTML=''; previewBox.appendChild(img);
            }
          };
          reader.readAsDataURL(file);
        });
      }

      // Optional: remove photo button triggers a flag (server should handle this)
      const removeBtn = document.getElementById('removePhoto');
      if (removeBtn) {
        removeBtn.addEventListener('click', () => {
          // create a hidden input to tell server to remove existing photo
          let existing = document.querySelector('input[name="removePhotoFlag"]');
          if (!existing) {
            existing = document.createElement('input');
            existing.type='hidden'; existing.name='removePhotoFlag'; existing.value='1';
            document.querySelector('form.add').appendChild(existing);
            removeBtn.textContent = 'Will remove on save'; removeBtn.disabled = true;
          }
        });
      }
    </script>
  </body>
</html>
<%- include('partials/head') %>
<style>
*{
      margin:0px;
      padding:0px;
      box-sizing: border-box;
    }
body{
      background-color: #d6eeeb00;
      color:#1a3d63;
      font-family: 'Lucida Sans', 'Lucida Sans Regular', 'Lucida Grande', 'Lucida Sans Unicode', Geneva, Verdana, sans-serif;
}

.info{
      border:1px solid #95DAEE;
      border-radius: 0.8rem;
      box-shadow: 1.2px 1.2px 6px #95DAEE;
      transition:all 0.3s ease-in-out;
      color:black;
      max-width: fit-content;
      cursor: pointer;
      padding:10px;
      position: relative;
    }
.info:hover{
      transform:scale(1.02);
}

.book{
      min-width: 100%;
      cursor: pointer;
      border:1px solid #95DAEE;
      border-radius: 1rem;
      transition:all 0.3s ease-in-out;
   }
.book:hover{
      transform:scale(1.02);
}
nav {
  border-radius: 3rem;
  background-color: #d6eeeb61;
  padding: 27px 10px 10px 0;
  align-items: center;
  border-radius: 8%;
  margin: 5px 10px;
}

nav ul {
  display: inline;
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  justify-content: space-around;
}

nav li {
  margin-left: 20px;
}

nav a {
  text-decoration: none;
  color: white;
  font-weight: bold;
  padding: 10px 10px;
  border-radius: 10px;
  transition: background-color 0.3s ease;
}

nav a:hover {
  background-color: #C7E4D9;
}

.container {
     display:flex;
      flex-direction: row;
      flex-wrap: wrap;
      gap:20px;
      margin:10px 4%;
      border-radius: 1px;
}

.home {
      border:none;
      background-color: #f6fafd;
      cursor: pointer;
      border-radius: 0.4rem;
      transition:all 0.3s ease-in-out;
}
.home>a  {
    color:#95DAEE;
    font-size: medium;
}
.home:hover {
  background-color: #C7E4D6
}

.fav {
      border:none;
      background-color: #f6fafd;
      cursor: pointer;
      border-radius: 0.4rem;
      transition:all 0.3s ease-in-out;
}
.fav>a  {
    color:#95DAEE;
    font-size: medium;
}
.fav:hover {
  background-color: #C7E4D6
}

.booking {
      border:none;
      background-color: #f6fafd;
      cursor: pointer;
      border-radius: 0.4rem;
      transition:all 0.3s ease-in-out;
}
.booking>a  {
    color:#95DAEE;
    font-size: medium;
}
.booking:hover {
  background-color: #C7E4D6
}

.host {
      border:none;
      background-color: #f6fafd;
      cursor: pointer;
      border-radius: 0.4rem;
      transition:all 0.3s ease-in-out;
}
.host>a  {
    color:#95DAEE;
    font-size: medium;
}
.host:hover {
  background-color: #C7E4D6
}

.add-home {
      border:none;
      background-color: #f6fafd;
      cursor: pointer;
      border-radius: 0.4rem;
      transition:all 0.3s ease-in-out;
}
.add-home>a  {
    color:#95DAEE;
    font-size: medium;
}
.add-home:hover {
  background-color: #C7E4D6
}

h2 {
  color: #333;
  font-size: 2rem;
}

.welcome {
  margin: 0 10px 0 100px;
  color: #95DAEE;
  display: inline;
  width:fit-content;
  font-size: x-large
}
.image {
      width: 375px;
      margin:10px 27px;
      border-radius: 10px;
      transition: all 0.3s ease-in-out;
}
.image:hover {
  transform:scale(1.02);
}
</style>
  </head>
  <body>
    <%- include('partials/nav') %>
    <main>
      <h2>404</h2>
      <p>Oops! Page Not Found</p>
      <a
        href="/"
        >Go Back Home</a
      >
    </main>
  </body>
</html>